<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Alumni Chat Network | Connect Like Facebook</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Poppins', system-ui, -apple-system, 'BlinkMacSystemFont', 'Roboto', sans-serif;
        }

        body {
            background: #18191a;
            height: 100vh;
            overflow: hidden;
        }

        /* Main App Container */
        .chat-app {
            display: flex;
            height: 100vh;
            width: 100%;
            background: #18191a;
        }

        /* Sidebar - Friends & Conversations */
        .sidebar {
            width: 320px;
            background: #242526;
            border-right: 1px solid #3e4042;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .sidebar-header {
            padding: 16px;
            background: #242526;
            border-bottom: 1px solid #3e4042;
        }

        .sidebar-header h2 {
            color: #e4e6eb;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-info {
            padding: 12px 16px;
            background: #3a3b3c;
            margin: 8px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: 0.2s;
        }

        .user-info:hover {
            background: #4e4f50;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #2e7d32;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .user-details {
            flex: 1;
        }

        .user-name {
            color: #e4e6eb;
            font-weight: 600;
        }

        .user-status {
            font-size: 12px;
            color: #b0b3b8;
        }

        .online-dot {
            width: 10px;
            height: 10px;
            background: #31a24c;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
        }

        .search-box {
            padding: 12px 16px;
        }

        .search-box input {
            width: 100%;
            padding: 10px 16px;
            border-radius: 24px;
            border: none;
            background: #3a3b3c;
            color: #e4e6eb;
            outline: none;
            font-size: 14px;
        }

        .friends-list {
            flex: 1;
            overflow-y: auto;
        }

        .friend-item {
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: 0.2s;
            border-radius: 8px;
            margin: 4px 8px;
        }

        .friend-item:hover {
            background: #3a3b3c;
        }

        .friend-item.active {
            background: #2e7d32;
        }

        .friend-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #4e4f50;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .friend-info {
            flex: 1;
        }

        .friend-name {
            color: #e4e6eb;
            font-weight: 500;
        }

        .last-message {
            font-size: 12px;
            color: #b0b3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 180px;
        }

        /* Chat Area */
        .chat-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: #18191a;
        }

        .chat-header {
            padding: 16px 24px;
            background: #242526;
            border-bottom: 1px solid #3e4042;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chat-header-info h3 {
            color: #e4e6eb;
        }

        .chat-header-info p {
            font-size: 12px;
            color: #b0b3b8;
        }

        .messages-container {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .message {
            display: flex;
            max-width: 70%;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .message.sent {
            align-self: flex-end;
            justify-content: flex-end;
        }

        .message.received {
            align-self: flex-start;
        }

        .message-bubble {
            padding: 10px 16px;
            border-radius: 20px;
            word-wrap: break-word;
            max-width: 100%;
        }

        .message.sent .message-bubble {
            background: #2e7d32;
            color: white;
            border-bottom-right-radius: 4px;
        }

        .message.received .message-bubble {
            background: #3a3b3c;
            color: #e4e6eb;
            border-bottom-left-radius: 4px;
        }

        .message-time {
            font-size: 10px;
            margin-top: 4px;
            color: #b0b3b8;
            text-align: right;
        }

        .message-input-area {
            padding: 20px;
            background: #242526;
            border-top: 1px solid #3e4042;
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .message-input-area input {
            flex: 1;
            padding: 12px 18px;
            border-radius: 24px;
            border: none;
            background: #3a3b3c;
            color: #e4e6eb;
            outline: none;
            font-size: 14px;
        }

        .message-input-area button {
            background: #2e7d32;
            border: none;
            padding: 12px 24px;
            border-radius: 24px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        .message-input-area button:hover {
            background: #1b5e20;
        }

        /* Auth Modal */
        .auth-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(12px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2000;
        }

        .auth-card {
            background: #242526;
            border-radius: 24px;
            padding: 32px;
            width: 400px;
            max-width: 90%;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        }

        .auth-tabs {
            display: flex;
            gap: 20px;
            margin-bottom: 24px;
            border-bottom: 2px solid #3e4042;
        }

        .auth-tab {
            padding: 12px 0;
            cursor: pointer;
            color: #b0b3b8;
            font-weight: 600;
        }

        .auth-tab.active {
            color: #2e7d32;
            border-bottom: 2px solid #2e7d32;
        }

        .auth-input {
            width: 100%;
            padding: 12px 16px;
            margin-bottom: 16px;
            background: #3a3b3c;
            border: none;
            border-radius: 12px;
            color: white;
            outline: none;
        }

        .auth-btn {
            width: 100%;
            padding: 12px;
            background: #2e7d32;
            border: none;
            border-radius: 12px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            margin-top: 8px;
        }

        .empty-chat {
            display: flex;
            flex: 1;
            align-items: center;
            justify-content: center;
            color: #b0b3b8;
            text-align: center;
            flex-direction: column;
            gap: 16px;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #3a3b3c;
        }

        ::-webkit-scrollbar-thumb {
            background: #2e7d32;
            border-radius: 10px;
        }
    </style>
</head>
<body>
<div id="app"></div>

<script>
    // ---------- DATA MODELS ----------
    const STORAGE_USERS = "fb_alumni_users";
    const STORAGE_MESSAGES = "fb_alumni_messages";
    
    let currentUser = null;
    let activeChatUserId = null;
    let users = [];
    let messages = {}; // { "userId1_userId2": [...] }

    // Load data
    function loadData() {
        const storedUsers = localStorage.getItem(STORAGE_USERS);
        if(storedUsers) {
            users = JSON.parse(storedUsers);
        } else {
            // Create 3 demo users for chat experience
            users = [
                { id: "1", fullName: "Aisha Bello", email: "aisha@example.com", password: "123", phone: "+234801234567", gender: "female", avatar: "👩‍🎓", bio: "Medical Student", online: true },
                { id: "2", fullName: "Ibrahim Musa", email: "ibrahim@example.com", password: "123", phone: "+234802345678", gender: "male", avatar: "👨‍💻", bio: "Software Engineer", online: true },
                { id: "3", fullName: "Fatima Suleiman", email: "fatima@example.com", password: "123", phone: "+234803456789", gender: "female", avatar: "👩‍🏫", bio: "Teacher", online: false }
            ];
            saveUsers();
        }

        const storedMessages = localStorage.getItem(STORAGE_MESSAGES);
        if(storedMessages) {
            messages = JSON.parse(storedMessages);
        } else {
            messages = {};
            // Seed some example messages between users
            addMessageToStorage("1", "2", "Hello Ibrahim! How are you?", new Date(Date.now() - 3600000).toISOString());
            addMessageToStorage("2", "1", "I'm good Aisha! Ready for the alumni meetup?", new Date(Date.now() - 3500000).toISOString());
            addMessageToStorage("1", "2", "Yes! Can't wait 😊", new Date(Date.now() - 3400000).toISOString());
            addMessageToStorage("1", "3", "Hey Fatima, long time!", new Date(Date.now() - 7200000).toISOString());
        }
    }

    function saveUsers() {
        localStorage.setItem(STORAGE_USERS, JSON.stringify(users));
    }

    function saveMessages() {
        localStorage.setItem(STORAGE_MESSAGES, JSON.stringify(messages));
    }

    function addMessageToStorage(fromId, toId, text, timestamp) {
        const key1 = `${fromId}_${toId}`;
        const key2 = `${toId}_${fromId}`;
        const existingKey = messages[key1] ? key1 : (messages[key2] ? key2 : null);
        if(existingKey) {
            messages[existingKey].push({ fromId, toId, text, timestamp, read: false });
        } else {
            messages[key1] = [{ fromId, toId, text, timestamp, read: false }];
        }
        saveMessages();
    }

    function getMessagesBetween(userId1, userId2) {
        const key = `${userId1}_${userId2}`;
        const reverseKey = `${userId2}_${userId1}`;
        if(messages[key]) return messages[key];
        if(messages[reverseKey]) return messages[reverseKey];
        return [];
    }

    function sendMessage(fromId, toId, text) {
        if(!text.trim()) return;
        const timestamp = new Date().toISOString();
        addMessageToStorage(fromId, toId, text, timestamp);
    }

    // Authentication
    function registerUser(fullName, email, password, gender) {
        if(users.some(u => u.email === email)) return { success: false, message: "Email already exists!" };
        const newUser = {
            id: Date.now().toString(),
            fullName: fullName.trim(),
            email: email.trim(),
            password: password,
            gender: gender,
            phone: "",
            bio: "",
            avatar: gender === 'male' ? '👨‍🎓' : '👩‍🎓',
            online: true,
            registeredAt: new Date().toISOString()
        };
        users.push(newUser);
        saveUsers();
        return { success: true, user: newUser };
    }

    function loginUser(email, password) {
        const user = users.find(u => u.email === email && u.password === password);
        if(user) {
            user.online = true;
            saveUsers();
            return { success: true, user };
        }
        return { success: false, message: "Invalid credentials" };
    }

    function logoutUser() {
        if(currentUser) {
            const user = users.find(u => u.id === currentUser.id);
            if(user) user.online = false;
            saveUsers();
        }
        currentUser = null;
        activeChatUserId = null;
    }

    // Get friends list (all other users except current)
    function getFriends() {
        return users.filter(u => u.id !== currentUser?.id);
    }

    function getFriendById(id) {
        return users.find(u => u.id === id);
    }

    // Render main chat UI
    function render() {
        const app = document.getElementById('app');
        if(!currentUser) {
            renderAuth(app);
            return;
        }
        renderChatApp(app);
    }

    function renderAuth(container) {
        let activeTab = 'login';
        
        const authHtml = `
            <div class="auth-overlay" id="authOverlay">
                <div class="auth-card">
                    <div class="auth-tabs" id="authTabs">
                        <div class="auth-tab ${activeTab === 'login' ? 'active' : ''}" data-tab="login">Login</div>
                        <div class="auth-tab ${activeTab === 'register' ? 'active' : ''}" data-tab="register">Register</div>
                    </div>
                    <div id="authForm">
                        <input type="email" id="loginEmail" class="auth-input" placeholder="Email" autocomplete="off">
                        <input type="password" id="loginPassword" class="auth-input" placeholder="Password">
                        <button id="loginBtn" class="auth-btn">Login to Chat</button>
                    </div>
                    <div style="text-align:center; margin-top:16px; color:#b0b3b8; font-size:12px;">
                        Demo accounts: aisha@example.com / 123 &nbsp;|&nbsp; ibrahim@example.com / 123
                    </div>
                </div>
            </div>
        `;
        container.innerHTML = authHtml;
        
        const switchTab = (tab) => {
            activeTab = tab;
            const formDiv = document.getElementById('authForm');
            if(tab === 'login') {
                formDiv.innerHTML = `
                    <input type="email" id="loginEmail" class="auth-input" placeholder="Email">
                    <input type="password" id="loginPassword" class="auth-input" placeholder="Password">
                    <button id="loginBtn" class="auth-btn">Login to Chat</button>
                `;
                document.getElementById('loginBtn')?.addEventListener('click', () => {
                    const email = document.getElementById('loginEmail').value;
                    const pwd = document.getElementById('loginPassword').value;
                    const res = loginUser(email, pwd);
                    if(res.success) {
                        currentUser = res.user;
                        render();
                    } else alert(res.message);
                });
            } else {
                formDiv.innerHTML = `
                    <input type="text" id="regName" class="auth-input" placeholder="Full Name">
                    <input type="email" id="regEmail" class="auth-input" placeholder="Email">
                    <input type="password" id="regPassword" class="auth-input" placeholder="Password">
                    <select id="regGender" class="auth-input">
                        <option value="male">Male</option>
                        <option value="female">Female</option>
                    </select>
                    <button id="registerBtn" class="auth-btn">Create Account</button>
                `;
                document.getElementById('registerBtn')?.addEventListener('click', () => {
                    const name = document.getElementById('regName').value;
                    const email = document.getElementById('regEmail').value;
                    const pwd = document.getElementById('regPassword').value;
                    const gender = document.getElementById('regGender').value;
                    if(!name || !email || !pwd) { alert("Fill all fields"); return; }
                    const res = registerUser(name, email, pwd, gender);
                    if(res.success) {
                        alert("Registration successful! Please login.");
                        switchTab('login');
                        const loginTabBtn = document.querySelector('[data-tab="login"]');
                        if(loginTabBtn) loginTabBtn.click();
                    } else alert(res.message);
                });
            }
            document.querySelectorAll('.auth-tab').forEach(tabEl => {
                tabEl.classList.remove('active');
                if(tabEl.getAttribute('data-tab') === activeTab) tabEl.classList.add('active');
            });
        };
        
        document.getElementById('loginBtn')?.addEventListener('click', () => {
            const email = document.getElementById('loginEmail').value;
            const pwd = document.getElementById('loginPassword').value;
            const res = loginUser(email, pwd);
            if(res.success) {
                currentUser = res.user;
                render();
            } else alert(res.message);
        });
        
        document.querySelectorAll('.auth-tab').forEach(tab => {
            tab.addEventListener('click', () => switchTab(tab.getAttribute('data-tab')));
        });
    }

    function renderChatApp(container) {
        const friends = getFriends();
        const activeFriend = activeChatUserId ? getFriendById(activeChatUserId) : null;
        const messagesList = activeChatUserId ? getMessagesBetween(currentUser.id, activeChatUserId) : [];
        
        const chatHtml = `
            <div class="chat-app">
                <!-- Sidebar -->
                <div class="sidebar">
                    <div class="sidebar-header">
                        <h2>💬 Alumni Connect</h2>
                    </div>
                    <div class="user-info" id="userProfileBtn">
                        <div class="avatar">${currentUser.avatar}</div>
                        <div class="user-details">
                            <div class="user-name">${escapeHtml(currentUser.fullName)}</div>
                            <div class="user-status"><span class="online-dot"></span> Online</div>
                        </div>
                    </div>
                    <div class="search-box">
                        <input type="text" id="searchFriends" placeholder="🔍 Search friends...">
                    </div>
                    <div class="friends-list" id="friendsList">
                        ${friends.map(friend => `
                            <div class="friend-item ${activeChatUserId === friend.id ? 'active' : ''}" data-userid="${friend.id}">
                                <div class="friend-avatar">${friend.avatar}</div>
                                <div class="friend-info">
                                    <div class="friend-name">${escapeHtml(friend.fullName)}</div>
                                    <div class="last-message">${getLastMessagePreview(friend.id)}</div>
                                </div>
                                ${friend.online ? '<div style="width:10px;height:10px;background:#31a24c;border-radius:50%;"></div>' : ''}
                            </div>
                        `).join('')}
                    </div>
                </div>
                
                <!-- Chat Area -->
                <div class="chat-area">
                    ${activeFriend ? `
                        <div class="chat-header">
                            <div class="friend-avatar" style="width:48px;height:48px;">${activeFriend.avatar}</div>
                            <div class="chat-header-info">
                                <h3>${escapeHtml(activeFriend.fullName)}</h3>
                                <p>${activeFriend.online ? '🟢 Online' : '⚫ Offline'} • ${activeFriend.bio || 'Alumni Member'}</p>
                            </div>
                        </div>
                        <div class="messages-container" id="messagesContainer">
                            ${messagesList.map(msg => {
                                const isSent = msg.fromId === currentUser.id;
                                return `
                                    <div class="message ${isSent ? 'sent' : 'received'}">
                                        <div class="message-bubble">
                                            ${escapeHtml(msg.text)}
                                            <div class="message-time">${formatTime(msg.timestamp)}</div>
                                        </div>
                                    </div>
                                `;
                            }).join('')}
                        </div>
                        <div class="message-input-area">
                            <input type="text" id="messageInput" placeholder="Type a message..." autocomplete="off">
                            <button id="sendMsgBtn">Send ➤</button>
                        </div>
                    ` : `
                        <div class="empty-chat">
                            <div style="font-size:4rem;">💬</div>
                            <h3>Select a friend to start chatting</h3>
                            <p>Click on any alumni from the left panel</p>
                        </div>
                    `}
                </div>
            </div>
        `;
        
        container.innerHTML = chatHtml;
        
        // Event Listeners
        document.querySelectorAll('.friend-item').forEach(el => {
            el.addEventListener('click', (e) => {
                const userId = el.getAttribute('data-userid');
                activeChatUserId = userId;
                render();
            });
        });
        
        if(activeChatUserId) {
            const input = document.getElementById('messageInput');
            const sendBtn = document.getElementById('sendMsgBtn');
            const sendMessageFn = () => {
                const text = input.value.trim();
                if(text) {
                    sendMessage(currentUser.id, activeChatUserId, text);
                    input.value = '';
                    render();
                    setTimeout(() => scrollToBottom(), 50);
                }
            };
            sendBtn?.addEventListener('click', sendMessageFn);
            input?.addEventListener('keypress', (e) => { if(e.key === 'Enter') sendMessageFn(); });
            scrollToBottom();
        }
        
        document.getElementById('searchFriends')?.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('.friend-item').forEach(item => {
                const name = item.querySelector('.friend-name')?.innerText.toLowerCase();
                if(name && name.includes(term)) item.style.display = 'flex';
                else item.style.display = 'none';
            });
        });
        
        document.getElementById('userProfileBtn')?.addEventListener('click', () => {
            if(confirm(`Logout ${currentUser.fullName}?`)) {
                logoutUser();
                render();
            }
        });
        
        // Auto refresh every 2 seconds (real-time simulation)
        if(window.chatInterval) clearInterval(window.chatInterval);
        window.chatInterval = setInterval(() => {
            if(currentUser) render();
        }, 2000);
    }
    
    function getLastMessagePreview(friendId) {
        const msgs = getMessagesBetween(currentUser.id, friendId);
        if(msgs.length === 0) return "No messages yet";
        const last = msgs[msgs.length - 1];
        const isFromMe = last.fromId === currentUser.id;
        const preview = last.text.length > 30 ? last.text.substring(0,30)+'...' : last.text;
        return `${isFromMe ? 'You: ' : ''}${preview}`;
    }
    
    function formatTime(isoString) {
        const date = new Date(isoString);
        const now = new Date();
        const diff = now - date;
        if(diff < 60000) return 'just now';
        if(diff < 3600000) return `${Math.floor(diff/60000)}m ago`;
        if(diff < 86400000) return `${Math.floor(diff/3600000)}h ago`;
        return date.toLocaleDateString();
    }
    
    function scrollToBottom() {
        const container = document.getElementById('messagesContainer');
        if(container) container.scrollTop = container.scrollHeight;
    }
    
    function escapeHtml(str) {
        if(!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if(m === '&') return '&amp;';
            if(m === '<') return '&lt;';
            if(m === '>') return '&gt;';
            return m;
        });
    }
    
    // Initialize
    loadData();
    render();
</script>
</body>
</html>
